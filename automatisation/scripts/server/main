#!/bin/bash

sudo apt update && sudo apt upgrade

sudo apt -y install freeradius freeradius-ldap
sudo apt -y install slapd ldap-utils

sudo debconf-set-selections <<EOF
slapd slapd/no_configuration boolean false
slapd slapd/internal/adminpw password 12345
slapd slapd/internal/adminpw_again password 12345
slapd slapd/domain string ucead.com
slapd shared/organization string UCAD
EOF

# Configuration par ici

# Verification après si tout marche
