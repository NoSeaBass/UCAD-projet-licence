# ============================================================
# Modele de configuration du projet
# ============================================================
# Copier vers config.env et adapter les valeurs.
# Ne JAMAIS commiter config.env dans Git.
# Les mots de passe sont saisis via configure.sh (whiptail) — ne pas
# les pre-remplir ici.
# ============================================================

HOSTNAME="serveur-peda"

LDAP_DOMAIN="etablissement.local"
LDAP_BASE_DN="dc=etablissement,dc=local"
LDAP_ADMIN_DN="cn=admin,dc=etablissement,dc=local"
# Mot de passe saisi par configure.sh (prompt interactif), jamais stocke ici.
LDAP_ADMIN_PASSWORD=""

SAMBA_WORKGROUP="ETABLISSEMENT"
SAMBA_NETBIOS_NAME=""

# Mot de passe utilisateurs saisi par configure.sh.
USER_PASSWORD=""

ENSEIGNANT01_UID=10001
ENSEIGNANT02_UID=10002
APPRENANT01_UID=20001
APPRENANT02_UID=20002
ENSEIGNANTS_GID=5001
APPRENANTS_GID=5002

# Secret RADIUS : saisi par configure.sh ou genere par openssl.
RADIUS_SHARED_SECRET=""

SHARES_BASE="/srv/partages"

# Mode d'authentification RADIUS : "email" (defaut memoire) ou "uid".
LDAP_AUTH_BY="email"
