# ============================================================
# Configuration du projet
# ============================================================
# Copier ce fichier vers config.env et adapter les valeurs.
# Ne jamais commiter config.env dans Git.
# ============================================================

HOSTNAME="serveur-peda"
TIMEZONE="Africa/Dakar"

IP_ADDRESS=""
NETMASK=""
GATEWAY=""
DNS_SERVERS="127.0.0.1 8.8.8.8"

LDAP_DOMAIN="etablissement.local"
LDAP_BASE_DN="dc=etablissement,dc=local"
LDAP_ADMIN_DN="cn=admin,dc=etablissement,dc=local"
LDAP_ADMIN_PASSWORD="admin"

SAMBA_WORKGROUP="ETABLISSEMENT"
SAMBA_NETBIOS_NAME=""

# Exemple d'utilisateurs avec comme mot de pass $USER_PASSWORD
# A commenter
USER_PASSWORD="user"
ENSEIGNANT01_UID=10001
ENSEIGNANT02_UID=10002
APPRENANT01_UID=20001
APPRENANT02_UID=20002
ENSEIGNANTS_GID=5001
APPRENANTS_GID=5002

RADIUS_SHARED_SECRET="admin"

SHARES_BASE="/srv/partages"
